MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=masi
MAIL_TIMEOUT=10
